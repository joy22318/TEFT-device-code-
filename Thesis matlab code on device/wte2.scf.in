&CONTROL
    calculation = "scf"
    title = 'Self-consistent field calculation of wte2'
    restart_mode = 'from_scratch'
    prefix = 'wte2'
    outdir = '.' 
    wfcdir = '.' 
    pseudo_dir = '.'  
    verbosity = 'high'
    tprnfor = .TRUE.
/

&SYSTEM
    a = 3.49794e+00
    b = 6.33827e+00
    c = 1.54319e+01
    ecutrho = 200  ! Increased from 400 Ry to 600 Ry for PAW
    ecutwfc = 50.0   ! Same as before
    ibrav = 8
    nat = 6
    ntyp = 2
    nbnd = 110
    noncolin = .TRUE.
    lspinorb = .TRUE.
    starting_magnetization = 0.0
	input_dft='hse', nqx1 = 10, nqx2 = 10, nqx3 = 1,
	x_gamma_extrapolation = .true.,
    exxdiv_treatment = 'gygi-baldereschi',
    nosym = .true., noinv = .true
/

&ELECTRONS
    conv_thr = 1.0d-6           ! Looser convergence threshold for initial SCF run
    electron_maxstep = 200
    mixing_mode = 'plain'
    mixing_beta = 0.3d0         ! Reduced mixing_beta from 0.3 to 0.2 for better stability
    diagonalization = 'david'
    diago_full_acc = .TRUE.
/

ATOMIC_SPECIES
Te    127.60000   Te_ONCV_PBE_fr.upf
W     183.84000   W_ONCV_PBE_fr.upf

